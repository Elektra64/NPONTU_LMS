<?php

namespace App\Http\Controllers;

use App\Models\Course;
use Illuminate\Http\Request;
use App\Models\User;

class CourseController extends Controller
{
    public function dashboard()
    {
        $courses = Course::all();
        $totalCourses = Course::count();
        $publishedCourses = Course::where('is_published', true)->count();
        $draftCourses = Course::where('is_published', false)->count();
        $totalUsers = User::count();

        return view('admin.courses.dashboard', compact('courses', 'totalCourses', 'publishedCourses', 'draftCourses', 'totalUsers'));
    }

    public function create()
    {
        return view('admin.courses.create');
    }

    public function store(Request $request)
    {
        // Validate the incoming request data
        $request->validate([
            'title' => 'required|string|max:255',
            'description' => 'nullable|string',
            'intro_content' => 'required|string',
            'difficulty_level' => 'required|string|in:beginner,intermediate,advanced',
            'time_limit' => 'nullable|integer',
            'status' => 'required|in:draft,published',
        ]);

        Course::create([
            'title' => $request->title,
            'description' => $request->description,
            'intro_content' => $request->intro_content,
            'difficulty_level' => $request->difficulty_level,
            'time_limit' => $request->time_limit,
            'status' => $request->status,
            'created_by' => auth()->id() // Assuming the course is created by the authenticated user
        ]);

        return redirect()->route('admin.courses.dashboard')
            ->with('success', 'Course created successfully.');
    }

     // Display the specified course
     public function show(Course $course)
     {
         return view('admin.courses.show', compact('course'));
     }
 
     // Show the form for editing the specified course
     public function edit(Course $course)
     {
         return view('admin.courses.edit', compact('course'));
     }
 
     // Update the specified course in the database
     public function update(Request $request, Course $course)
     {
         $request->validate([
             'title' => 'required|string|max:255',
             'description' => 'nullable|string',
             'intro_content' => 'required|string',
             'difficulty_level' => 'required|string|in:beginner,intermediate,advanced',
             'time_limit' => 'nullable|integer',
             'status' => 'required|in:draft,published',
         ]);
 
         // Only allow updates if the course is not published
         if ($course->is_published) {
             return redirect()->route('admin.courses.dashboard')->with('error', 'Cannot update a published course.');
         }
 
         $course->update($request->all());
 
         return redirect()->route('admin.courses.dashboard')->with('success', 'Course updated successfully!');
     }
 
     // Remove the specified course from the database
     public function destroy(Course $course)
     {
         if ($course->is_published) {
             return redirect()->route('admin.courses.dashboard')->with('error', 'Cannot delete a published course.');
         }
 
         $course->delete();
 
         return redirect()->route('admin.courses.dashboard')->with('success', 'Course deleted successfully!');
     }
 
}